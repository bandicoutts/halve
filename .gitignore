# Dependencies
node_modules/
.pnp.*
.yarn/*

# Build output
.next/
out/
dist/
build/
*.tsbuildinfo

# Environment / secrets
.env
.env.*
!.env.example

# Supabase local
supabase/.branches/
supabase/.temp/
**/supabase/.env

# Logs & caches
*.log
npm-debug.log*
.turbo/
.cache/
coverage/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Claude local settings (machine-specific permissions; shared settings.json is fine to commit)
.claude/settings.local.json

# Flutter / Dart (apps/mobile — see apps/mobile/.gitignore for the full set)
**/.dart_tool/
**/build/
*.iml
**/.flutter-plugins
**/.flutter-plugins-dependencies
apps/mobile/ios/Pods/
apps/mobile/ios/.symlinks/
apps/mobile/android/.gradle/
apps/mobile/.idea/

# Design loop — prototype artifacts (design-only, replaced each round; contract docs are tracked)
packages/design/mobile/prototype/
