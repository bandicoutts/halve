{
  "name": "parity",
  "version": "0.0.0",
  "private": true,
  "description": "Premium daily binary-logic puzzle app (fire & water).",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "seed-puzzles": "tsx --tsconfig scripts/tsconfig.json scripts/seed-puzzles.ts",
    "seed-practice-pool": "tsx --tsconfig scripts/tsconfig.json scripts/seed-practice-pool.ts",
    "mobile:run": "cd apps/mobile && flutter run --dart-define-from-file=env.json",
    "mobile:gen": "cd apps/mobile && dart run build_runner build --delete-conflicting-outputs",
    "mobile:test": "cd apps/mobile && flutter test",
    "mobile:analyze": "cd apps/mobile && flutter analyze"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "postcss": ">=8.5.10"
    }
  },
  "devDependencies": {
    "tsx": "^4.22.3"
  }
}
