# Supabase project URL and publishable (anon) key — safe to expose to the client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Service-role key — bypasses ALL row-level security (full DB access).
# LOCAL DEVELOPMENT ONLY. Do NOT set this in the Vercel production/preview
# environment: the deployed web app does not use it (its only consumer,
# /api/dev-login, is disabled outside NODE_ENV=development). Putting a
# god-mode key in the web tier turns any future server bug into a full breach.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Secret that gates the dev-only /api/dev-login verification helper.
# Set to any random local value (e.g. `openssl rand -hex 24`). If unset, the
# route is disabled. Local only — never set in a deployed environment.
DEV_LOGIN_SECRET=
